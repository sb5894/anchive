rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /events/{eventId}/posts/{postId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 50 * 1024 * 1024)
        );
      // 업로드된 파일은 앱에서 직접 수정/삭제하지 않는다(게시물은 Firestore에서 소프트 삭제만 함).
      // write로 뭉뚱그리면 로그인한 아무나 남의 파일을 지울 수 있어서 create만 따로 허용한다.
      // 실제 파일 정리는 관리자 스크립트(Admin SDK, 규칙 우회)로만 한다.
      allow update, delete: if false;
    }
  }
}
